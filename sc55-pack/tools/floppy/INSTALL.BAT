@ECHO OFF
REM NUKED SB-EMU floppy install.  INSTALL [target drive] [floppy drive]   (default C and A)
SET NSBD=%1
SET NSBS=%2
IF "%NSBD%"=="" SET NSBD=C
IF "%NSBS%"=="" SET NSBS=A
IF NOT EXIST %NSBS%:\DISK1.PAK GOTO NOSRC
IF NOT EXIST %NSBD%:\NUL GOTO NODRV
ECHO.
ECHO  NUKED SB-EMU AWE32 Edition - floppy install
ECHO  Unpacks all disks to %NSBD%:\NUKEDSB, then runs SETUP %NSBD%.
ECHO.
IF NOT EXIST %NSBD%:\NUKEDSB\NUL MD %NSBD%:\NUKEDSB
IF NOT EXIST %NSBD%:\NUKEDSB\FLOPPY\NUL MD %NSBD%:\NUKEDSB\FLOPPY
IF NOT EXIST %NSBD%:\NUKEDSB\FLOPPY\NUL GOTO NODRV
COPY %NSBS%:\UNPAK.EXE %NSBD%:\NUKEDSB\FLOPPY > NUL
COPY %NSBS%:\HDPMI32I.EXE %NSBD%:\NUKEDSB\FLOPPY > NUL
COPY %NSBS%:\INST2.BAT %NSBD%:\NUKEDSB\FLOPPY > NUL
IF NOT EXIST %NSBD%:\NUKEDSB\FLOPPY\INST2.BAT GOTO NODRV
%NSBD%:\NUKEDSB\FLOPPY\INST2
:NOSRC
ECHO Disk 1 not found in drive %NSBS%:  Run INSTALL from disk 1, e.g.  A:\INSTALL C
GOTO END
:NODRV
ECHO Cannot write to drive %NSBD%:  (usage: INSTALL [target drive] [floppy drive])
:END
