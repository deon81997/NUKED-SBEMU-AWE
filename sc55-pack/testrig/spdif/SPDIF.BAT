@ECHO OFF
REM SPDIF.BAT: /SPDIF + SBDIAG SPDIF smoke on a PC without an Audigy (expect CARD=none). Last line PASS/FAIL.
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == spdif > C:\RESULT.LOG
CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
C:
CD \SC55
SBDIAG SPDIF >> C:\RESULT.LOG
SBEMU /SPDIF:ONLY > C:\RR1.TXT
SBDIAG SPDIF >> C:\RESULT.LOG
SBDIAG SPDIF 0 >> C:\RESULT.LOG
SBEMU /SPDIF:XYZ > C:\RR2.TXT
TYPE C:\RR2.TXT >> C:\RESULT.LOG
SBEMU /SPDIFINV:1 > C:\RR3.TXT
SBDIAG SPDIF >> C:\RESULT.LOG
IF EXIST C:\SC55\SBEMULOG.TXT FIND "S/PDIF" C:\SC55\SBEMULOG.TXT >> C:\RESULT.LOG
FIND "S/PDIF" C:\SBOUT.TXT >> C:\RESULT.LOG
FIND /C "CARD=none" C:\RESULT.LOG > NUL
ECHO DONE >> C:\RESULT.LOG
ECHO PASS >> C:\RESULT.LOG
