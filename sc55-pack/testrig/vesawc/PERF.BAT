@ECHO OFF
REM PERF EXE OPTS: no-slowdown check for /VWC (86Box P3B-F PII-450 + ES1371 + Voodoo3). SBEMU EXE with OPTS + the
REM TimGM6mb SoundFont, SBDIAG START, MIDPLAY of a busy 16-channel song for 40 s, SBDIAG report -> C:\RESULT.LOG.
C:
CD \NUKEDSB
CALL SETUP C > NUL
C:
CD \SC55
C:\HDPMI\HDPMI32I.EXE -r -x > NUL
ECHO == %1 %2 %3 > C:\RESULT.LOG
C:\%1 /VSF:C:\TIMGM6MB.SF2 %2 %3 > C:\SB.TXT
FIND "write-combining" C:\SB.TXT >> C:\RESULT.LOG
SBDIAG.EXE WC >> C:\RESULT.LOG
SBDIAG.EXE START > NUL
MIDPLAY.EXE /S /Q:40 C:\T.MID > NUL
SBDIAG.EXE > C:\DIAG.TXT
TYPE C:\DIAG.TXT >> C:\RESULT.LOG
ECHO DONE PASS >> C:\RESULT.LOG
