@ECHO OFF
REM DBG.BAT MODE [HANG]: SBEMU /DBG serial link. MODE pm (SC55.BAT, HIMEM + HDPMI) or rm (SC55JEM.BAT, JEMMEX).
REM The host (testrig/dbg/run.sh) reads COM1 and checks the lines; this log only says the batch got through.
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == dbg %1 %2 > C:\RESULT.LOG
IF "%1"=="rm" GOTO RM
CALL C:\SC55\SC55.BAT /DBG:COM1:1 > C:\SBOUT.TXT
GOTO LOADED
:RM
CALL C:\SC55\SC55JEM.BAT /DBG:COM1:1 > C:\SBOUT.TXT
:LOADED
C:
CD \SC55
SBDIAG DBG >> C:\RESULT.LOG
IF "%2"=="HANG" GOTO HANG
IF "%1"=="rm" C:\SBT.COM > NUL
MPUTEST > NUL
SC55MENU.EXE C:\SC55 /STATUS > NUL
GAMETEST /USB > NUL
SBDIAG DBG LOG hello from the batch
SBDIAG DBG LEVEL 2 >> C:\RESULT.LOG
IF "%1"=="rm" C:\SBT.COM > NUL
MPUTEST > NUL
SBDIAG DBG LEVEL 3 >> C:\RESULT.LOG
IF "%1"=="rm" C:\SBT.COM > NUL
MPUTEST > NUL
SBDIAG DBG DUMP >> C:\RESULT.LOG
C:\DOS\CHOICE /T:Y,20 /C:YN wait > NUL
SBDIAG DBG >> C:\RESULT.LOG
REM a tool on its own port: SBEMU's link at level 0 -> SBDIAG opens COM1 itself
SBDIAG DBG LEVEL 0 >> C:\RESULT.LOG
SBDIAG /DBG:COM1 WC > NUL
SBDIAG DBG LEVEL 1 >> C:\RESULT.LOG
SBDIAG DBG LOG batch done
ECHO PASS >> C:\RESULT.LOG
GOTO END
:HANG
IF "%1"=="rm" C:\SBT.COM > NUL
SBDIAG DBG LOG next: forced hang
SBDIAG DBG HANG
ECHO FAIL still running after HANG >> C:\RESULT.LOG
:END
