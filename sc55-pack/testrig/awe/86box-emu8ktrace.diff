diff --git a/src/io.c b/src/io.c
index 2b8f794a2..9ac15166e 100644
--- a/src/io.c
+++ b/src/io.c
@@ -95,6 +95,26 @@ io_log(const char *fmt, ...)
 #    define io_log(fmt, ...)
 #endif
 
+/* EMU8000 stream capture (NUKED SB-EMU AWE testrig): EMU8K_TRACE=file logs native EMU8000 port accesses
+   (snd_emu8k.c) and an SBEMU trace build's records written to port 5E0h (dword: bit31 out, bits 16-27 offset, low 16 value) */
+#include <stdio.h>
+#include <stdlib.h>
+#include <86box/timer.h>
+static FILE *emu8k_tf;
+static int emu8k_tf_init;
+void emu8k_trace(char k, unsigned off, unsigned val)
+{
+    if (!emu8k_tf_init) { const char *f = getenv("EMU8K_TRACE"); emu8k_tf_init = 1; if (f) emu8k_tf = fopen(f, "w"); }
+    static unsigned n;
+    if (emu8k_tf) { fprintf(emu8k_tf, "%llu %c %03X %04X\n", (unsigned long long) tsc, k, off & 0xFFF, val & 0xFFFF); if (!(++n & 1023)) fflush(emu8k_tf); }
+}
+static void emu8k_dbg_outl(uint16_t port, uint32_t val, void *priv)
+{
+    (void) port; (void) priv;
+    emu8k_trace((val & 0x80000000u) ? 'w' : 'r', (val >> 16) & 0xFFF, val & 0xFFFF);
+}
+static void emu8k_dbg_outw(uint16_t port, uint16_t val, void *priv) { (void) port; (void) priv; if (val == 0xFFFF && emu8k_tf) fflush(emu8k_tf); }
+
 void
 io_init(void)
 {
@@ -128,6 +148,8 @@ io_init(void)
 
     memset(io_claims, 0x00, sizeof(io_claims));
     memset(io_claimed, 0x00, sizeof(io_claimed));
+    if (getenv("EMU8K_TRACE"))
+        io_sethandler(0x5E0, 4, NULL, NULL, NULL, NULL, emu8k_dbg_outw, emu8k_dbg_outl, NULL);
 }
 
