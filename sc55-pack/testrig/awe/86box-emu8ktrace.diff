     emu8k->ram[addr - EMU8K_RAM_MEM_START] = val;
 }
 
+void emu8k_trace(char k, unsigned off, unsigned val);
+uint16_t emu8k_inw_raw(uint16_t addr, void *priv);
+void emu8k_outw_raw(uint16_t addr, uint16_t val, void *priv);
+uint16_t emu8k_inw(uint16_t addr, void *priv);
+void emu8k_outw(uint16_t addr, uint16_t val, void *priv);
 uint16_t
-emu8k_inw(uint16_t addr, void *priv)
+emu8k_inw_raw(uint16_t addr, void *priv)
 {
     emu8k_t *emu8k = (emu8k_t *) priv;
     uint16_t ret   = 0xffff;
@@ -789,7 +794,7 @@ emu8k_inw(uint16_t addr, void *priv)
 }
 
 void
-emu8k_outw(uint16_t addr, uint16_t val, void *priv)
+emu8k_outw_raw(uint16_t addr, uint16_t val, void *priv)
 {
     emu8k_t *emu8k = (emu8k_t *) priv;
 
@@ -1534,9 +1539,7 @@ emu8k_inb(uint16_t addr, void *priv)
 {
     /* Reading a single byte is a feature that at least Impulse tracker uses,
      * but only on detection code and not for odd addresses.*/
-    if (addr & 1)
-        return emu8k_inw(addr & ~1, priv) >> 8;
-    return emu8k_inw(addr, priv) & 0xff;
+    { uint16_t r = emu8k_inw_raw(addr & ~1, priv); r = (addr & 1) ? r >> 8 : r & 0xff; emu8k_trace('r', addr - ((emu8k_t *) priv)->addr, r); return r; }
 }
 
 void
@@ -1544,10 +1547,11 @@ emu8k_outb(uint16_t addr, uint8_t val, void *priv)
 {
     /* TODO: AWE32 docs says that you cannot write in bytes, but if
      * an app were to use this implementation, the content of the LS Byte would be lost.*/
+    emu8k_trace('w', addr - ((emu8k_t *) priv)->addr, val);
     if (addr & 1)
-        emu8k_outw(addr & ~1, val << 8, priv);
+        emu8k_outw_raw(addr & ~1, val << 8, priv);
     else
-        emu8k_outw(addr, val, priv);
+        emu8k_outw_raw(addr, val, priv);
 }
 
 /* TODO: This is not a correct emulation, just a workalike implementation. */
@@ -2387,3 +2391,17 @@ emu8k_close(emu8k_t *emu8k)
     if (emu8k->ram)
         free(emu8k->ram);
 }
+
+uint16_t
+emu8k_inw(uint16_t addr, void *priv)
+{
+    uint16_t r = emu8k_inw_raw(addr, priv);
+    emu8k_trace('R', addr - ((emu8k_t *) priv)->addr, r);
+    return r;
+}
+void
+emu8k_outw(uint16_t addr, uint16_t val, void *priv)
+{
+    emu8k_trace('W', addr - ((emu8k_t *) priv)->addr, val);
+    emu8k_outw_raw(addr, val, priv);
+}
